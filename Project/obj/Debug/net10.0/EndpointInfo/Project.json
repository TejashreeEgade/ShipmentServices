{
  "openapi": "3.0.4",
  "info": {
    "title": "Project",
    "version": "1.0"
  },
  "paths": {
    "/api/Shipment": {
      "post": {
        "tags": [
          "Shipment"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Shipment"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Shipment/{id}": {
      "get": {
        "tags": [
          "Shipment"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Shipment"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Shipment/Status": {
      "put": {
        "tags": [
          "Shipment"
        ],
        "parameters": [
          {
            "name": "shipmentId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "newStatus",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ShipmentStatus"
            }
          },
          {
            "name": "changedBy",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "remarks",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Shipment/Summary": {
      "get": {
        "tags": [
          "Shipment"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast/GETDetails": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ShipmentHistoryModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "shipmentId": {
            "type": "integer",
            "format": "int32"
          },
          "previosStatus": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "newStatus": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "changedBy": {
            "type": "integer",
            "format": "int32"
          },
          "remarks": {
            "type": "string",
            "nullable": true
          },
          "changedAt": {
            "type": "string",
            "format": "date-time"
          },
          "shipment": {
            "$ref": "#/components/schemas/ShipmentModel"
          }
        },
        "additionalProperties": false
      },
      "ShipmentMode": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "ShipmentModel": {
        "required": [
          "customerName",
          "destination",
          "mode",
          "origin",
          "shipmentNumber",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "shipmentNumber": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "customerName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "origin": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "destination": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/ShipmentMode"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "estimatedRevenue": {
            "type": "number",
            "format": "double"
          },
          "estimatedCost": {
            "type": "number",
            "format": "double"
          },
          "branchId": {
            "type": "integer",
            "format": "int32"
          },
          "assignedEmployeeId": {
            "type": "integer",
            "format": "int32"
          },
          "expectedDepartureDate": {
            "type": "string",
            "format": "date-time"
          },
          "expectedArrivalDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "statusHistories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentHistoryModel"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShipmentStatus": {
        "enum": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "type": "integer",
        "format": "int32"
      }
    }
  },
  "tags": [
    {
      "name": "Shipment"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}